<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="__SKY__">
  <title>__NAME__</title>
  <script>
    // 个性设置 · 修改后保存文件并刷新浏览器即可。
    const SETTINGS = {
      __COLORS__
      particleCount: __COUNT__,        // 树身粒子数，范围 400 到 4800
      greeting: __GREETING__ // 祝福语，留空即可隐藏
    };
  </script>
  <style>
    :root { color-scheme: dark; background: __SKY__; }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html, body, main { width: 100%; height: 100%; margin: 0; }
    main { position: relative; overflow: hidden; isolation: isolate; }
    canvas, #surface { position: absolute; inset: 0; width: 100%; height: 100%; }
    canvas { display: block; pointer-events: none; }
    button { -webkit-tap-highlight-color: transparent; color: inherit; font: inherit; }
    #surface {
      border: 0; margin: 0; padding: 0; background: transparent; appearance: none;
      touch-action: pan-y pinch-zoom; cursor: grab; -webkit-user-select: none; user-select: none;
    }
    #surface.is-dragging { cursor: grabbing; }
    #surface:focus-visible { outline: 2px solid var(--ink, ivory); outline-offset: -6px; }
    #greeting {
      position: absolute; left: 50%; top: 85%; margin: 0; width: max-content; max-width: 88%;
      transform: translate(-50%, -50%); pointer-events: none; text-align: center;
      color: var(--ink, ivory); font-family: "Baskervville", "Iowan Old Style", "Palatino Linotype",
        "Songti SC", "Noto Serif CJK SC", SimSun, Georgia, serif;
      font-size: clamp(1.125rem, 2.8vmin, 1.75rem); font-weight: 400; line-height: 1.5;
      letter-spacing: .13em; overflow-wrap: anywhere; text-wrap: balance;
      text-shadow: 0 0 18px var(--haze, transparent);
    }
    .tools {
      position: absolute; top: max(12px, env(safe-area-inset-top));
      right: max(12px, env(safe-area-inset-right)); display: flex; gap: 4px;
      opacity: 0; pointer-events: none; transition: opacity 300ms cubic-bezier(.22,1,.36,1);
    }
    main.awake .tools, .tools:has(button:focus-visible) { opacity: 1; pointer-events: auto; }
    .tools button {
      display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid transparent;
      border-radius: 50%; background: transparent; color: var(--ink, ivory); cursor: pointer;
      opacity: .8;
    }
    .tools button:hover, .tools button:focus-visible { background: #ffffff12; opacity: 1; }
    .tools button:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
    .tools button:active { transform: scale(.94); }
    .pause-icon { height: 12px; width: 10px; border-inline: 2px solid currentColor; }
    #pause[data-paused="true"] .pause-icon {
      width: 0; height: 0; border: 0; border-left: 9px solid currentColor;
      border-top: 6px solid transparent; border-bottom: 6px solid transparent;
    }
    .replay-icon { position: relative; width: 15px; height: 15px; border: 1.5px solid;
      border-left-color: transparent; border-radius: 50%; transform: rotate(-22deg); }
    .replay-icon::after { content: ""; position: absolute; left: 0; top: -2px; width: 5px;
      height: 5px; border-left: 1.5px solid; border-bottom: 1.5px solid; transform: rotate(12deg); }
    .sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
      clip-path: inset(50%); white-space: nowrap; border: 0; }
    noscript { position: absolute; inset: 45% 5% auto; text-align: center; color: white; }
    @media (prefers-reduced-motion: reduce) { .tools { transition: none; } }
  </style>
</head>
<body>
  <main id="stage">
    <h1 class="sr">__NAME__</h1>
    <canvas id="art" aria-hidden="true"></canvas>
    <button type="button" id="surface" aria-label="与粒子互动"></button>
    <p id="greeting"></p>
    <div class="tools" role="group" aria-label="播放控制">
      <button type="button" id="replay" aria-label="重播完整演示" title="重播完整演示"><span class="replay-icon" aria-hidden="true"></span></button>
      <button type="button" id="pause" aria-label="暂停动画" title="暂停动画"><span class="pause-icon" aria-hidden="true"></span></button>
    </div>
    <noscript>请用启用了 JavaScript 的浏览器打开这棵树。</noscript>
  </main>
  <script>
    "use strict";
__DRAWING__
__EFFECTS__
__SCENE__
__PLAYER__
  </script>
</body>
</html>
