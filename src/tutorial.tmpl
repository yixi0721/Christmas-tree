<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>粒子圣诞树制作教程</title>
  <style>
    :root { color-scheme: light; color: #282c27; background: #f8f7f2;
      font: 100%/1.65 "Geist", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; }
