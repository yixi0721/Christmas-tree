    body { margin: 0; }
    main { max-width: 880px; margin: 0 auto; padding: 48px 32px 64px; }
    h1, h2 { color: #172b23; text-wrap: balance; }
    h1 { margin: 0 0 8px; font: 600 clamp(2rem, 5vw, 3rem)/1.18 "Baskervville", "Songti SC", SimSun, serif; }
    h2 { font-size: 1.5rem; line-height: 1.4; margin: 40px 0 12px; }
    p, ol, dl { margin: 8px 0 16px; }
    .intro { margin: 0 0 24px; color: #46534a; }
    .preview { display: block; width: 100%; height: auto; border-radius: 12px; }
    .samples { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); margin: 0; }
    .samples a { padding: 12px 4px; text-align: center; font-weight: 600; }
    a { color: #255b48; text-underline-offset: .20em; }
    a:hover { color: #0e3929; }
    :focus-visible { outline: 2px solid #216b4f; outline-offset: 3px; }
    ol { padding-inline-start: 24px; }
    li { padding-inline-start: 4px; margin: 8px 0; }
    code, kbd, pre { font-family: "IBM Plex Mono", Consolas, "Microsoft YaHei", monospace; }
    code { overflow-wrap: anywhere; }
    kbd { font-size: .9em; background: #ebece4; padding: 2px 4px; border-radius: 4px; white-space: nowrap; }
